// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model User {
    id        String   @id @default(cuid())
    name      String
    email     String   @unique
    password  String
    role      String   @default("bidder")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Tender {
    id                 String   @id @default(cuid())
    tenderNumber       String   @unique
    title              String
    authority          String
    category           String
    value              Float
    location           String
    submissionDeadline DateTime
    publishDate        DateTime
    emdAmount          Float?
    tenderFee          Float?
    status             String   @default("active")
    sourcePortal       String   @default("GeM")
    description        String?
    documentsCount     Int      @default(0)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
}

model Bid {
    id                  String   @id @default(cuid())
    tenderId            String
    tenderNumber        String
    tenderTitle         String
    clientName          String
    estimatedValue      Float
    quotedAmount        Float
    profitMargin        Float?
    stage               String   @default("drafting")
    status              String   @default("active")
    submissionDeadline  DateTime
    submissionDate      DateTime?
    teamMembers         String?
    documentsCount      Int      @default(0)
    checklistProgress   Float    @default(0)
    notes               String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
}

model Vendor {
    id             String   @id @default(cuid())
    name           String
    contactPerson  String?
    email          String?
    phone          String?
    category       String
    rating         Float    @default(5.0)
    status         String   @default("active")
    gstin          String?
    pan            String?
    address        String?
    bankDetails    String?
    materialsCount Int      @default(0)
    notes          String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

model Competitor {
    id                  String   @id @default(cuid())
    name                String
    gstin               String?
    contactPerson       String?
    email               String?
    phone               String?
    marketStrength      String   @default("medium")
    typicalDiscountRate Float    @default(0)
    historicalWinRate   Float    @default(0)
    bidsSubmittedCount  Int      @default(0)
    bidsWonCount        Int      @default(0)
    notes               String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
}

model CompetitorBid {
    id                   String   @id @default(cuid())
    tenderId             String
    tenderNumber         String
    tenderTitle          String
    competitorId         String
    competitorName       String
    quotedPrice          Float
    ourPrice             Float?
    technicalScore       Float    @default(90)
    rank                 String   @default("L2")
    isWinner             Boolean  @default(false)
    priceVariancePercent Float    @default(0)
    marginSpread         Float    @default(0)
    notes                String?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt
}

model BOQItem {
    id            String   @id @default(cuid())
    tenderId      String
    groupName     String   @default("Schedule A")
    itemCode      String
    description   String
    quantity      Float    @default(1)
    uom           String   @default("Nos")
    estimatedRate Float    @default(0)
    ourQuotedRate Float    @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model CompetitorItemRate {
    id             String   @id @default(cuid())
    boqItemId      String
    competitorId   String
    competitorName String
    quotedUnitRate Float
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

model DataEntrySheet {
    id            String   @id @default(cuid())
    name          String
    description   String?
    category      String   @default("general")
    tenderId      String?
    columnHeaders String
    cells         String
    rowCount      Int      @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
}

model Alert {
    id        String   @id @default(cuid())
    title     String
    message   String
    type      String   @default("deadline")
    isRead    Boolean  @default(false)
    tenderId  String?
    createdAt DateTime @default(now())
}

model AutomationRule {
    id          String   @id @default(cuid())
    name        String
    event       String
    conditions  String
    actions     String
    isEnabled   Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model AppSetting {
    key       String   @id
    value     String
    updatedAt DateTime @updatedAt
}
